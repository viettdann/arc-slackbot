SLACK_BOT_TOKEN=xoxb-...
# App-level token with connections:write (Basic Information -> App-Level Tokens)
SLACK_APP_TOKEN=xapp-...
ALLOWED_USER_ID=U0123456789
CHANNELS_FILE=./channels.json
DB_PATH=./data/bot.db
# Days to keep run history and downloaded attachments; 0 keeps them forever.
RETENTION_DAYS=30

# Do not set ANTHROPIC_API_KEY: the bot uses your Claude login (or CLAUDE_CODE_OAUTH_TOKEN) and refuses to start if it is set.
